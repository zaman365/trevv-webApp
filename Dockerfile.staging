# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=22.23.2
ARG PNPM_VERSION=11.22.0

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS alpine-runtime
RUN apk upgrade --no-cache

FROM alpine-runtime AS tls-init
RUN apk add --no-cache openssl
COPY deploy/staging/create-local-tls.sh /usr/local/bin/create-local-tls.sh
ENTRYPOINT ["sh", "/usr/local/bin/create-local-tls.sh"]

FROM alpine-runtime AS mail-init

FROM postgres:17-alpine@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73 AS postgres-runtime
RUN apk upgrade --no-cache

FROM node:${NODE_VERSION}-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
ARG NODE_VERSION
ARG PNPM_VERSION
ARG STAGING_PUBLIC_ORIGIN=https://127.0.0.1:8443
ARG STAGING_CSP_MODE=report-only
ARG STAGING_HSTS_ENABLED=false
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV CI=true
ENV DEMO_MODE=false
ENV NEXT_PUBLIC_APP_URL=${STAGING_PUBLIC_ORIGIN}
ENV API_ORIGIN=https://proxy:8444
ENV CSP_MODE=${STAGING_CSP_MODE}
ENV HSTS_ENABLED=${STAGING_HSTS_ENABLED}
WORKDIR /app
RUN apk upgrade --no-cache && \
    test "$(node --version)" = "v${NODE_VERSION}" && \
    corepack enable && \
    corepack prepare pnpm@${PNPM_VERSION} --activate
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
RUN pnpm exec turbo run build \
  --filter=@founderhq/api \
  --filter=@founderhq/worker \
  --filter=@founderhq/web
RUN pnpm --config.inject-workspace-packages=true \
      --filter=@founderhq/api --prod deploy --no-optional /runtime/api && \
    pnpm --config.inject-workspace-packages=true \
      --filter=@founderhq/worker --prod deploy --no-optional /runtime/worker && \
    pnpm --config.inject-workspace-packages=true \
      --filter=@founderhq/db --prod deploy --no-optional /runtime/db

FROM node:${NODE_VERSION}-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS service-runtime
RUN apk upgrade --no-cache && \
    apk add --no-cache dumb-init && \
    rm -rf \
      /opt/yarn-v1.22.22 \
      /usr/local/lib/node_modules/corepack \
      /usr/local/lib/node_modules/npm && \
    rm -f \
      /usr/local/bin/corepack \
      /usr/local/bin/npm \
      /usr/local/bin/npx \
      /usr/local/bin/pnpm \
      /usr/local/bin/pnpx \
      /usr/local/bin/yarn \
      /usr/local/bin/yarnpkg
ENV NODE_ENV=production
ENV NODE_OPTIONS=--conditions=production
WORKDIR /app
USER node
ENTRYPOINT ["dumb-init", "--"]

FROM service-runtime AS api
COPY --from=build --chown=node:node /runtime/api /app/apps/api
COPY --from=build --chown=node:node /app/scripts/api-readiness.mjs /app/scripts/api-readiness.mjs
EXPOSE 8787
CMD ["node", "apps/api/dist/index.js"]

FROM service-runtime AS worker
COPY --from=build --chown=node:node /runtime/worker /app/apps/worker
EXPOSE 9090
CMD ["node", "apps/worker/dist/index.js"]

FROM service-runtime AS migrate
COPY --from=build --chown=node:node /runtime/db /app/packages/db
CMD ["node", "packages/db/dist/migrate.js"]

# Published as trevv-migrate for remote operator use. Keep the generic migrate
# target above for the isolated NODE_ENV=test compose topology only.
FROM service-runtime AS remote-migrate
COPY --from=build --chown=node:node /runtime/db /app/packages/db
CMD ["node", "packages/db/dist/staging-migrate.js"]

FROM service-runtime AS topology-runtime
COPY --from=build --chown=node:node /app /app

FROM topology-runtime AS smoke
CMD ["node", "scripts/staging-smoke.mjs"]

FROM topology-runtime AS upgrade-smoke
CMD ["node", "scripts/staging-upgrade-smoke.mjs"]

FROM topology-runtime AS foundation-upgrade-smoke
CMD ["node", "scripts/synthetic-migration-rehearsal.mjs"]

FROM node:${NODE_VERSION}-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS web
RUN apk upgrade --no-cache && \
    apk add --no-cache dumb-init && \
    rm -rf \
      /opt/yarn-v1.22.22 \
      /usr/local/lib/node_modules/corepack \
      /usr/local/lib/node_modules/npm && \
    rm -f \
      /usr/local/bin/corepack \
      /usr/local/bin/npm \
      /usr/local/bin/npx \
      /usr/local/bin/pnpm \
      /usr/local/bin/pnpx \
      /usr/local/bin/yarn \
      /usr/local/bin/yarnpkg
ENV NODE_ENV=production
ENV NODE_EXTRA_CA_CERTS=/etc/trevv-local-tls/ca.crt
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/web/server.js"]

FROM nginx:stable-alpine-slim@sha256:ddde39c6e51f02fde7410c2e9c234cf2d0a4c7bdbbe176aeb37d8ad7ab4eb58c AS proxy
RUN apk upgrade --no-cache && \
    install -d -m 0755 /run/nginx
COPY deploy/staging/nginx.conf /etc/nginx/nginx.conf
EXPOSE 8080 8443
