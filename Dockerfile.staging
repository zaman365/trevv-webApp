# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=22.19.0
ARG PNPM_VERSION=11.22.0

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce AS tls-init
RUN apk add --no-cache openssl
COPY deploy/staging/create-local-tls.sh /usr/local/bin/create-local-tls.sh
ENTRYPOINT ["sh", "/usr/local/bin/create-local-tls.sh"]

FROM node:${NODE_VERSION}-alpine@sha256:d2166de198f26e17e5a442f537754dd616ab069c47cc57b889310a717e0abbf9 AS build
ARG NODE_VERSION
ARG PNPM_VERSION
ARG STAGING_PUBLIC_ORIGIN=https://127.0.0.1:8443
ARG STAGING_CSP_MODE=report-only
ARG STAGING_HSTS_ENABLED=false
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV CI=true
ENV DEMO_MODE=false
ENV NEXT_PUBLIC_APP_URL=${STAGING_PUBLIC_ORIGIN}
ENV API_ORIGIN=https://proxy:8444
ENV CSP_MODE=${STAGING_CSP_MODE}
ENV HSTS_ENABLED=${STAGING_HSTS_ENABLED}
WORKDIR /app
RUN test "$(node --version)" = "v${NODE_VERSION}" && \
    corepack enable && \
    corepack prepare pnpm@${PNPM_VERSION} --activate
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
RUN pnpm exec turbo run build \
  --filter=@founderhq/api \
  --filter=@founderhq/worker \
  --filter=@founderhq/web

FROM node:${NODE_VERSION}-alpine@sha256:d2166de198f26e17e5a442f537754dd616ab069c47cc57b889310a717e0abbf9 AS service-runtime
RUN apk add --no-cache dumb-init
ENV NODE_ENV=production
ENV NODE_OPTIONS=--conditions=production
WORKDIR /app
COPY --from=build --chown=node:node /app /app
USER node
ENTRYPOINT ["dumb-init", "--"]

FROM service-runtime AS api
EXPOSE 8787
CMD ["node", "apps/api/dist/index.js"]

FROM service-runtime AS worker
EXPOSE 9090
CMD ["node", "apps/worker/dist/index.js"]

FROM service-runtime AS migrate
CMD ["node", "packages/db/dist/migrate.js"]

# Published as trevv-migrate for remote operator use. Keep the generic migrate
# target above for the isolated NODE_ENV=test compose topology only.
FROM service-runtime AS remote-migrate
CMD ["node", "packages/db/dist/staging-migrate.js"]

FROM service-runtime AS smoke
CMD ["node", "scripts/staging-smoke.mjs"]

FROM service-runtime AS upgrade-smoke
CMD ["node", "scripts/staging-upgrade-smoke.mjs"]

FROM service-runtime AS foundation-upgrade-smoke
CMD ["node", "scripts/synthetic-migration-rehearsal.mjs"]

FROM node:${NODE_VERSION}-alpine@sha256:d2166de198f26e17e5a442f537754dd616ab069c47cc57b889310a717e0abbf9 AS web
RUN apk add --no-cache dumb-init
ENV NODE_ENV=production
ENV NODE_EXTRA_CA_CERTS=/etc/trevv-local-tls/ca.crt
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/web/server.js"]

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS proxy
COPY deploy/staging/nginx.conf /etc/nginx/nginx.conf
EXPOSE 8080 8443
