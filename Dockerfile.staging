# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=22.19.0
ARG PNPM_VERSION=11.22.0

FROM alpine:3.22 AS tls-init
RUN apk add --no-cache openssl
COPY deploy/staging/create-local-tls.sh /usr/local/bin/create-local-tls.sh
ENTRYPOINT ["sh", "/usr/local/bin/create-local-tls.sh"]

FROM node:${NODE_VERSION}-alpine AS build
ARG PNPM_VERSION
ARG STAGING_PUBLIC_ORIGIN=https://127.0.0.1:8443
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV CI=true
ENV DEMO_MODE=false
ENV NEXT_PUBLIC_APP_URL=${STAGING_PUBLIC_ORIGIN}
ENV API_ORIGIN=https://proxy:8443
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
RUN pnpm exec turbo run build \
  --filter=@founderhq/api \
  --filter=@founderhq/worker \
  --filter=@founderhq/web

FROM node:${NODE_VERSION}-alpine AS service-runtime
RUN apk add --no-cache dumb-init
ENV NODE_ENV=production
ENV NODE_OPTIONS=--conditions=production
WORKDIR /app
COPY --from=build --chown=node:node /app /app
USER node
ENTRYPOINT ["dumb-init", "--"]

FROM service-runtime AS api
EXPOSE 8787
CMD ["node", "apps/api/dist/index.js"]

FROM service-runtime AS worker
EXPOSE 9090
CMD ["node", "apps/worker/dist/index.js"]

FROM service-runtime AS migrate
CMD ["node", "packages/db/dist/migrate.js"]

FROM service-runtime AS smoke
CMD ["node", "scripts/staging-smoke.mjs"]

FROM service-runtime AS upgrade-smoke
CMD ["node", "scripts/staging-upgrade-smoke.mjs"]

FROM node:${NODE_VERSION}-alpine AS web
RUN apk add --no-cache dumb-init
ENV NODE_ENV=production
ENV NODE_EXTRA_CA_CERTS=/etc/trevv-local-tls/ca.crt
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/web/server.js"]

FROM nginx:1.27-alpine AS proxy
COPY deploy/staging/nginx.conf /etc/nginx/nginx.conf
EXPOSE 8080 8443
