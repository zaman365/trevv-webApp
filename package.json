{
  "name": "founderhq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @founderhq/web dev",
    "dev:api": "pnpm --filter @founderhq/api dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @founderhq/db test:integration && pnpm --filter @founderhq/api test:integration",
    "test:e2e": "playwright test tests/e2e/critical-paths.spec.ts tests/e2e/capability-truth.spec.ts tests/e2e/visual-regressions.spec.ts",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:phase6": "node --test scripts/phase6-readiness.test.mjs scripts/phase6-claims.test.mjs scripts/phase6-release-manifest.test.mjs scripts/web-performance-budget.test.mjs",
    "security:audit": "node scripts/audit.mjs",
    "phase6:readiness": "node scripts/phase6-readiness.mjs validate",
    "phase6:claims": "node scripts/phase6-claims.mjs validate",
    "performance:budget": "node scripts/web-performance-budget.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @founderhq/db generate",
    "db:migrate": "pnpm --filter @founderhq/db migrate",
    "db:seed": "pnpm --filter @founderhq/db seed",
    "contracts:generate": "pnpm --filter @founderhq/api-contract generate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.55.1",
    "@types/node": "latest",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "5.9.3"
  }
}
