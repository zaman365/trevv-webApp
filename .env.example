# Product
NEXT_PUBLIC_APP_NAME=TREVV
NEXT_PUBLIC_DEMO_ORGANIZATION=TREVV Demo
NEXT_PUBLIC_PRIMARY_DOMAIN=trevv.de
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787/api/v1
API_ORIGIN=http://localhost:8787
EXPO_PUBLIC_API_URL=http://localhost:8787/api/v1
VITE_API_URL=http://localhost:8787/api/v1
DEMO_MODE=true
NODE_ENV=development

# PostgreSQL and authentication
DATABASE_URL=postgresql://founderhq:founderhq@localhost:5432/founderhq
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:3000
AUTH_COOKIE_DOMAIN=
TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Required in live mode. MAIL_SINK_FILE may replace every SMTP_* variable only
# in nonproduction browser tests and must point inside the system temp folder.
MAIL_FROM=no-reply@trevv.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_SINK_FILE=

# Optional Google Drive integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Optional storage and observability
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
POSTHOG_KEY=
