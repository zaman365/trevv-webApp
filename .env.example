# Product
NEXT_PUBLIC_APP_NAME=TREVV
NEXT_PUBLIC_DEMO_ORGANIZATION=TREVV Demo
NEXT_PUBLIC_PRIMARY_DOMAIN=trevv.de
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RUM_ENABLED=false
NEXT_PUBLIC_RUM_SAMPLE_RATE=0.1
WEB_VITALS_INGEST_ENABLED=false
NEXT_PUBLIC_API_URL=http://localhost:8787/api/v1
# Web server only: use the private HTTPS API load-balancer/service origin in
# live deployments. Browser requests stay same-origin through the Web boundary.
API_ORIGIN=http://localhost:8787
EXPO_PUBLIC_API_URL=http://localhost:8787/api/v1
VITE_API_URL=http://localhost:8787/api/v1
DEMO_MODE=true
NODE_ENV=development

# Immutable packaged-artifact identity. Production requires all three. The
# deployment controller must inject the actual full Git SHA and OCI/Docker
# sha256 digest or image ID; never use a tag such as latest. Local source-mode
# development may omit them. RELEASE_METADATA_REQUIRED=true lets a
# production-shaped test topology enforce the same rule under NODE_ENV=test.
RELEASE_ID=
RELEASE_GIT_SHA=
RELEASE_IMAGE_ID=
RELEASE_METADATA_REQUIRED=false

# Web security headers are compiled into the Web artifact. Changing either
# value requires a new Web build; setting them only on a running container has
# no effect. Keep HSTS off for HTTP/self-signed local work. Promote CSP to
# enforce and HSTS to true only for a reviewed, trusted-HTTPS deployment.
CSP_MODE=report-only
HSTS_ENABLED=false

# API-only PostgreSQL and authentication settings. Plaintext is local-only;
# production requires exactly one sslmode=verify-full so the database server
# certificate and hostname are verified against the runtime's trusted CA store.
DATABASE_URL=postgresql://founderhq:founderhq@localhost:5432/founderhq
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:3000
# Shared by API and Web. The alpha origin requires trevv_alpha so a stale
# trevv.de predecessor session cannot satisfy its optimistic route boundary.
AUTH_COOKIE_PREFIX=trevv
# Leave empty in production. Browser sessions use host-only cookies through the
# same-origin Web API boundary; parent-domain cookies would leak into every
# lower-assurance subdomain.
AUTH_COOKIE_DOMAIN=
# Live account admission. invite_only is the safe default and requires an
# unexpired, unrevoked, unconsumed invitation token whose stored email matches
# the sign-up email. closed disables all new account creation, including for
# invitees. public is test/development-only until public-release gates pass and
# production startup rejects it.
REGISTRATION_MODE=invite_only

# API request protection and error-reporting policy. The process-local memory
# limiter is for development/test only. Production requires postgres plus a
# non-placeholder 32+ character HMAC secret shared by every API replica. The
# trusted client-IP header must be overwritten by a trusted edge; never accept
# the public caller's value. No external error reporter is provisioned, so the
# packaged runtime must remain disabled until a reviewed adapter is installed.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_HASH_SECRET=
TRUSTED_CLIENT_IP_HEADER=
ERROR_REPORTING_MODE=disabled
# Public Prometheus endpoints are disabled in production until they sit behind
# a private telemetry boundary. Development/test defaults to enabled.
INTERNAL_METRICS_ENABLED=false

# Required in live mode. MAIL_SINK_FILE may replace every SMTP_* variable only
# in nonproduction browser tests and must point inside the system temp folder.
MAIL_FROM=no-reply@trevv.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_SINK_FILE=

# Background worker (used only with DEMO_MODE=false and a live DATABASE_URL).
# WORKER_ID is required for the worker and must be unique per running instance.
# WORKER_ID=trevv-worker-local-1
# WORKER_ENABLED=true
# WORKER_DISABLED_HANDLERS=
# WORKER_POLL_INTERVAL_MS=1000
# WORKER_ATTENTION_SWEEP_INTERVAL_MS=60000
# WORKER_TELEMETRY_INTERVAL_MS=30000
# WORKER_READINESS_MAX_STALENESS_MS=60000
# Ready work older than this threshold makes readiness fail.
# WORKER_READINESS_MAX_READY_AGE_MS=300000
# Unknown outbox events make readiness fail after this five-minute grace period.
# WORKER_READINESS_MAX_UNSUPPORTED_AGE_MS=300000
# Any dead letter fails readiness by default. Raising this limit requires an
# explicit, reviewed operator policy and does not replace inspection/redrive.
# WORKER_READINESS_MAX_DEAD_LETTERS=0
# WORKER_BATCH_SIZE=5
# WORKER_CONCURRENCY=5
# WORKER_LEASE_MS=30000
# WORKER_MAX_ATTEMPTS=8
# WORKER_HEALTH_HOST=127.0.0.1
# WORKER_HEALTH_PORT=9090

# No provider OAuth, private object storage, external error collector,
# analytics, billing, or AI configuration is supported in this release. Do not
# invent provider variables or credentials until evidence, privacy review, an
# implementation, and an explicit enablement decision all exist.
