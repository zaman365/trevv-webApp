{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TREVV",
  "version": "0.1.0",
  "identifier": "de.trevv.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TREVV",
        "width": 1320,
        "height": 850,
        "minWidth": 920,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8787 https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": true, "targets": "all" }
}
