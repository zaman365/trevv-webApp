{
  "name": "@founderhq/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./openapi": {
      "production": "./dist/openapi.js",
      "default": "./src/openapi.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "generate": "tsx src/generate.ts"
  },
  "dependencies": {
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  }
}
